# RESERVE DEMO 6. The mistake: a token passed in as a build argument.
# Never do this. docker history shows the value to anyone with the image.
FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ARG API_TOKEN
RUN echo "I only print the token's length: ${#API_TOKEN}"

ENV PORT=8080
EXPOSE 8080
USER 1000:1000
CMD ["python3", "src/server.py"]
